# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts run in WSL and in the CI container, where CRLF breaks bash
*.sh text eol=lf

# Makefiles run with make in WSL, where CRLF breaks recipes
Makefile text eol=lf

# Test fixtures are compared byte for byte (CRLF, UTF-16 and Latin-1 cases)
tests/fixtures/** -text
